@import 
url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

:root {
  font-family:
    "Inter",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #172033;
  background: #f6f8fb;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  --primary: #4f46e5;
  --primary-dark: #4338ca;
  --primary-soft: #eef2ff;

  --navy: #101828;
  --navy-2: #172033;

  --text: #172033;
  --text-secondary: #667085;
  --text-muted: #98a2b3;

  --border: #e7eaf0;
  --border-light: #eef0f4;

  --surface: #ffffff;
  --background: #f6f8fb;

  --success: #12b76a;
  --warning: #f79009;
  --danger: #f04438;
  --info: #2e90fa;

  --sidebar-width: 250px;
  --topbar-height: 72px;

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;

  --shadow-sm:
    0 1px 2px rgba(16, 24, 40, 0.04),
    0 2px 6px rgba(16, 24, 40, 0.03);

  --shadow-md:
    0 8px 24px rgba(16, 24, 40, 0.06);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--background);
  color: var(--text);
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  border: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

#root {
  min-height: 100vh;
}

::selection {
  color: #fff;
  background: var(--primary);
}

::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #cbd0da;
  border-radius: 99px;
}

/* =========================================================
   APPLICATION SHELL
   ========================================================= */

.tf-app-shell {
  min-height: 100vh;
  background: var(--background);
}

.tf-main {
  min-height: 100vh;
  margin-left: var(--sidebar-width);
  padding-bottom: 50px;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.tf-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 100;
  width: var(--sidebar-width);
  height: 100vh;

  display: flex;
  flex-direction: column;

  color: #c8d0dc;
  background:
    linear-gradient(
      180deg,
      #101828 0%,
      #0d1625 100%
    );

  border-right: 1px solid rgba(255, 255, 255, 0.05);
}

/* Brand */

.tf-brand {
  height: var(--topbar-height);
  padding: 0 22px;

  display: flex;
  align-items: center;
  gap: 12px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.tf-brand-mark {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #4338ca
    );

  box-shadow:
    0 6px 18px rgba(79, 70, 229, 0.35);
}

.tf-brand-mark span {
  font-size: 17px;
  font-weight: 800;
}

.tf-brand-mark.small {
  width: 32px;
  height: 32px;
}

.tf-brand-copy {
  min-width: 0;
}

.tf-brand-name {
  color: #fff;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.tf-brand-subtitle {
  margin-top: 2px;
  color: #7f8b9d;
  font-size: 10px;
  font-weight: 500;
}

/* Sidebar navigation */

.tf-sidebar-content {
  flex: 1;
  padding: 24px 13px;
  overflow-y: auto;
}

.tf-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.tf-nav-section {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.tf-nav-heading {
  padding: 0 12px 7px;

  color: #667387;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.tf-nav-link {
  min-height: 43px;
  padding: 0 11px;

  display: flex;
  align-items: center;
  gap: 11px;

  color: #aeb8c7;

  border-radius: 9px;

  transition:
    background 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.tf-nav-link:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.055);
}

.tf-nav-link.active {
  color: #fff;
  background:
    linear-gradient(
      90deg,
      rgba(99, 102, 241, 0.22),
      rgba(99, 102, 241, 0.08)
    );

  box-shadow:
    inset 3px 0 0 #6366f1;
}

.tf-nav-icon {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  color: #7f8ba0;
}

.tf-nav-link.active .tf-nav-icon {
  color: #a5b4fc;
}

.tf-nav-label {
  flex: 1;

  font-size: 12px;
  font-weight: 600;
}

.tf-nav-arrow {
  opacity: 0;
  color: #718096;

  transform: translateX(-4px);

  transition:
    opacity 0.18s ease,
    transform 0.18s ease;
}

.tf-nav-link:hover .tf-nav-arrow,
.tf-nav-link.active .tf-nav-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* Sidebar user */

.tf-sidebar-footer {
  padding: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
}

.tf-user-card {
  min-height: 58px;
  padding: 9px;

  display: flex;
  align-items: center;
  gap: 9px;

  border-radius: 10px;

  background: rgba(255, 255, 255, 0.045);
}

.tf-user-avatar,
.tf-topbar-avatar {
  width: 34px;
  height: 34px;

  flex: 0 0 auto;

  display: grid;
  place-items: center;

  border-radius: 9px;

  color: #fff;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #7c3aed
    );

  font-size: 12px;
  font-weight: 800;
}

.tf-user-details {
  min-width: 0;
  flex: 1;

  display: flex;
  flex-direction: column;
  gap: 3px;
}

.tf-user-details strong {
  overflow: hidden;

  color: #f8fafc;

  font-size: 11px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-user-details span {
  overflow: hidden;

  color: #78859a;

  font-size: 9px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-logout-button {
  width: 30px;
  height: 30px;

  display: grid;
  place-items: center;

  color: #7d899b;
  background: transparent;

  border-radius: 7px;

  cursor: pointer;

  transition: 0.18s ease;
}

.tf-logout-button:hover {
  color: #fca5a5;
  background: rgba(239, 68, 68, 0.1);
}

/* =========================================================
   TOP NAVBAR
   ========================================================= */

.tf-topbar {
  position: sticky;
  top: 0;
  z-index: 50;

  height: var(--topbar-height);

  padding: 0 32px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;

  background: rgba(255, 255, 255, 0.94);

  border-bottom: 1px solid var(--border-light);

  backdrop-filter: blur(14px);
}

.tf-topbar-left,
.tf-topbar-right {
  display: flex;
  align-items: center;
}

.tf-topbar-left {
  gap: 20px;
}

.tf-topbar-right {
  gap: 16px;
}

.tf-mobile-brand {
  display: none;
  align-items: center;
  gap: 9px;
}

.tf-mobile-brand strong {
  font-size: 14px;
  font-weight: 800;
}

.tf-global-search {
  width: 350px;
  height: 38px;

  padding: 0 11px;

  display: flex;
  align-items: center;
  gap: 9px;

  color: #98a2b3;

  background: #f8fafc;

  border: 1px solid #e4e7ec;
  border-radius: 9px;

  transition:
    border-color 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.tf-global-search:focus-within {
  background: #fff;
  border-color: #a5b4fc;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.08);
}

.tf-global-search input {
  width: 100%;

  border: 0;
  outline: 0;

  color: #344054;
  background: transparent;

  font-size: 11px;
}

.tf-global-search input::placeholder {
  color: #98a2b3;
}

.tf-global-search kbd {
  padding: 3px 6px;

  color: #98a2b3;
  background: #fff;

  border: 1px solid #e4e7ec;
  border-radius: 5px;

  font-size: 9px;
}

.tf-icon-button {
  width: 35px;
  height: 35px;

  display: grid;
  place-items: center;

  position: relative;

  color: #667085;
  background: transparent;

  border-radius: 8px;

  cursor: pointer;

  transition: 0.18s ease;
}

.tf-icon-button:hover {
  color: #4f46e5;
  background: #f2f4f7;
}

.tf-notification-dot {
  position: absolute;
  top: 8px;
  right: 8px;

  width: 6px;
  height: 6px;

  border: 1.5px solid #fff;
  border-radius: 50%;

  background: #f04438;
}

.tf-topbar-divider {
  width: 1px;
  height: 27px;
  background: #eaecf0;
}

.tf-topbar-user {
  display: flex;
  align-items: center;
  gap: 9px;
}

.tf-topbar-avatar {
  width: 34px;
  height: 34px;
}

.tf-topbar-user-copy {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.tf-topbar-user-copy strong {
  color: #344054;
  font-size: 11px;
  font-weight: 700;
}

.tf-topbar-user-copy span {
  color: #98a2b3;
  font-size: 9px;
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.tf-dashboard {
  max-width: 1500px;
  margin: 0 auto;
  padding: 30px 34px;
}

.tf-dashboard-header {
  margin-bottom: 27px;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
}

.tf-eyebrow {
  display: flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 9px;

  color: #6366f1;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.tf-live-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #12b76a;

  box-shadow: 0 0 0 4px rgba(18, 183, 106, 0.1);
}

.tf-dashboard-header h1 {
  margin: 0;

  color: #101828;

  font-size: clamp(26px, 3vw, 32px);
  line-height: 1.15;

  letter-spacing: -0.045em;

  font-weight: 800;
}

.tf-dashboard-header h1 span {
  color: #4f46e5;
}

.tf-dashboard-header p {
  margin: 9px 0 0;

  color: #667085;

  font-size: 12px;
  line-height: 1.6;
}

/* Buttons */

.tf-primary-button,
.tf-secondary-button,
.tf-outline-button,
.tf-cancel-button {
  min-height: 40px;
  padding: 0 15px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  border-radius: 8px;

  font-size: 11px;
  font-weight: 700;

  cursor: pointer;

  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.tf-primary-button {
  color: #fff;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #4f46e5
    );

  box-shadow:
    0 6px 16px rgba(79, 70, 229, 0.2);
}

.tf-primary-button:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
  box-shadow:
    0 9px 22px rgba(79, 70, 229, 0.25);
}

.tf-secondary-button {
  color: #4f46e5;
  background: #eef2ff;
}

.tf-secondary-button:hover {
  background: #e0e7ff;
}

.tf-outline-button,
.tf-cancel-button {
  color: #475467;
  background: #fff;
  border: 1px solid #dfe3ea;
}

.tf-outline-button:hover,
.tf-cancel-button:hover {
  color: #4f46e5;
  border-color: #c7d2fe;
  background: #f8faff;
}

/* =========================================================
   KPI CARDS
   ========================================================= */

.tf-kpi-grid {
  margin-bottom: 25px;

  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 15px;
}

.tf-kpi-card {
  min-height: 145px;

  position: relative;
  overflow: hidden;

  padding: 19px;

  background: #fff;

  border: 1px solid var(--border);
  border-radius: 13px;

  box-shadow: var(--shadow-sm);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.tf-kpi-card:hover {
  transform: translateY(-2px);

  border-color: #d9dce5;

  box-shadow: var(--shadow-md);
}

.tf-kpi-card::after {
  content: "";

  position: absolute;

  right: -35px;
  bottom: -50px;

  width: 130px;
  height: 130px;

  border-radius: 50%;

  background: rgba(99, 102, 241, 0.035);
}

.tf-kpi-top {
  position: relative;
  z-index: 1;

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 18px;
}

.tf-kpi-icon {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  border-radius: 10px;
}

.tf-kpi-card.blue .tf-kpi-icon {
  color: #2563eb;
  background: #eff6ff;
}

.tf-kpi-card.violet .tf-kpi-icon {
  color: #7c3aed;
  background: #f5f3ff;
}

.tf-kpi-card.amber .tf-kpi-icon {
  color: #d97706;
  background: #fffbeb;
}

.tf-kpi-card.green .tf-kpi-icon {
  color: #059669;
  background: #ecfdf5;
}

.tf-kpi-label {
  color: #667085;

  font-size: 10px;
  font-weight: 600;
}

.tf-kpi-card > strong {
  position: relative;
  z-index: 1;

  display: block;

  color: #101828;

  font-size: 27px;
  line-height: 1;

  letter-spacing: -0.045em;
}

.tf-kpi-detail {
  position: relative;
  z-index: 1;

  display: block;

  margin-top: 9px;

  color: #98a2b3;

  font-size: 9px;
}

/* =========================================================
   DASHBOARD CONTENT
   ========================================================= */

.tf-dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.75fr);
  gap: 16px;
}

.tf-panel {
  background: #fff;

  border: 1px solid var(--border);
  border-radius: 14px;

  box-shadow: var(--shadow-sm);
}

.tf-applications-panel {
  min-height: 470px;
  overflow: hidden;
}

.tf-panel-header {
  padding: 21px 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.tf-panel-header h2 {
  margin: 0;

  color: #101828;

  font-size: 14px;
  font-weight: 750;

  letter-spacing: -0.02em;
}

.tf-panel-header p {
  margin: 5px 0 0;

  color: #98a2b3;

  font-size: 10px;
}

.tf-text-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  color: #4f46e5;

  font-size: 10px;
  font-weight: 700;
}

.tf-text-link:hover {
  color: #3730a3;
}

/* Search */

.tf-search-wrapper {
  height: 39px;

  margin: 0 22px 17px;
  padding: 0 11px;

  display: flex;
  align-items: center;
  gap: 9px;

  color: #98a2b3;
  background: #f8fafc;

  border: 1px solid #e4e7ec;
  border-radius: 8px;
}

.tf-search-wrapper:focus-within {
  background: #fff;
  border-color: #a5b4fc;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.07);
}

.tf-search-wrapper input {
  width: 100%;

  border: 0;
  outline: 0;

  color: #344054;
  background: transparent;

  font-size: 10px;
}

.tf-search-wrapper input::placeholder {
  color: #98a2b3;
}

/* Applications */

.tf-application-list {
  border-top: 1px solid var(--border-light);
}

.tf-application-row {
  min-height: 76px;

  padding: 12px 22px;

  display: flex;
  align-items: center;
  gap: 13px;

  border-bottom: 1px solid #f2f4f7;

  transition: background 0.16s ease;
}

.tf-application-row:hover {
  background: #fafbff;
}

.tf-company-avatar {
  width: 38px;
  height: 38px;

  flex: 0 0 auto;

  display: grid;
  place-items: center;

  color: #4f46e5;
  background: #eef2ff;

  border: 1px solid #e0e7ff;
  border-radius: 10px;

  font-size: 12px;
  font-weight: 800;
}

.tf-application-main {
  min-width: 0;
  flex: 1;

  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tf-application-main strong {
  overflow: hidden;

  color: #344054;

  font-size: 11px;
  font-weight: 700;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-application-main span {
  overflow: hidden;

  color: #98a2b3;

  font-size: 9px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-status,
.tf-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  white-space: nowrap;

  border-radius: 999px;

  font-size: 9px;
  font-weight: 700;
}

.tf-status {
  padding: 5px 8px;
}

.tf-status.status-applied,
.tf-status-badge.applied {
  color: #175cd3;
  background: #eff8ff;
}

.tf-status.status-interview,
.tf-status-badge.interview {
  color: #b54708;
  background: #fffaeb;
}

.tf-status.status-offer,
.tf-status-badge.offer {
  color: #027a48;
  background: #ecfdf3;
}

.tf-status.status-rejected,
.tf-status-badge.rejected {
  color: #b42318;
  background: #fef3f2;
}

.tf-row-date {
  min-width: 58px;

  color: #98a2b3;

  font-size: 9px;
  text-align: right;
}

/* =========================================================
   PIPELINE
   ========================================================= */

.tf-side-column {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.tf-progress-panel {
  padding-bottom: 22px;
}

.tf-progress-panel > .tf-panel-header svg {
  color: #6366f1;
}

.tf-pipeline {
  padding: 0 22px;

  display: grid;
  gap: 19px;
}

.tf-pipeline-row {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.tf-pipeline-label {
  display: flex;
  align-items: center;
  justify-content: space-between;

  color: #667085;

  font-size: 10px;
  font-weight: 600;
}

.tf-pipeline-label strong {
  color: #344054;
  font-size: 10px;
}

.tf-progress-track {
  height: 6px;

  overflow: hidden;

  background: #f2f4f7;

  border-radius: 999px;
}

.tf-progress-fill {
  height: 100%;

  min-width: 0;

  border-radius: inherit;

  transition: width 0.4s ease;
}

.tf-progress-fill.blue {
  background: #3b82f6;
}

.tf-progress-fill.amber {
  background: #f79009;
}

.tf-progress-fill.green {
  background: #12b76a;
}

.tf-progress-fill.red {
  background: #f04438;
}

/* Insight */

.tf-insight-card {
  min-height: 115px;

  padding: 20px;

  display: flex;
  align-items: center;
  gap: 13px;

  background:
    linear-gradient(
      135deg,
      #ffffff 0%,
      #fafaff 100%
    );

  border: 1px solid #e4e7ff;
  border-radius: 14px;

  box-shadow: var(--shadow-sm);
}

.tf-insight-icon {
  width: 40px;
  height: 40px;

  flex: 0 0 auto;

  display: grid;
  place-items: center;

  color: #4f46e5;
  background: #eef2ff;

  border-radius: 10px;
}

.tf-insight-card strong {
  color: #344054;

  font-size: 11px;
  font-weight: 750;
}

.tf-insight-card p {
  max-width: 270px;

  margin: 5px 0 0;

  color: #98a2b3;

  font-size: 9px;
  line-height: 1.55;
}

/* =========================================================
   EMPTY / LOADING
   ========================================================= */

.tf-empty-state {
  min-height: 300px;

  padding: 45px 25px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.tf-empty-icon {
  width: 50px;
  height: 50px;

  margin-bottom: 13px;

  display: grid;
  place-items: center;

  color: #6366f1;
  background: #eef2ff;

  border-radius: 13px;
}

.tf-empty-state h3 {
  margin: 0;

  color: #344054;

  font-size: 13px;
  font-weight: 700;
}

.tf-empty-state p {
  max-width: 360px;

  margin: 7px 0 17px;

  color: #98a2b3;

  font-size: 10px;
  line-height: 1.6;
}

.tf-loading-list {
  padding: 0 22px;
}

.tf-skeleton-row {
  height: 65px;

  display: flex;
  align-items: center;
  gap: 15px;

  border-bottom: 1px solid #f2f4f7;
}

.tf-skeleton-row div {
  height: 11px;

  border-radius: 6px;

  background:
    linear-gradient(
      90deg,
      #f2f4f7 25%,
      #e9edf2 50%,
      #f2f4f7 75%
    );

  background-size: 200% 100%;

  animation: tf-shimmer 1.4s infinite;
}

.tf-skeleton-row div:first-child {
  width: 38px;
  height: 38px;
  border-radius: 10px;
}

.tf-skeleton-row div:nth-child(2) {
  width: 40%;
}

.tf-skeleton-row div:nth-child(3) {
  width: 70px;
}

@keyframes tf-shimmer {
  from {
    background-position: 200% 0;
  }

  to {
    background-position: -200% 0;
  }
}

/* =========================================================
   APPLICATIONS PAGE
   ========================================================= */

.tf-page-header {
  padding: 30px 34px 22px;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
}

.tf-back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  margin-bottom: 15px;

  color: #667085;

  font-size: 10px;
  font-weight: 600;
}

.tf-back-link:hover {
  color: #4f46e5;
}

.tf-page-title-row {
  display: flex;
  align-items: center;
  gap: 13px;
}

.tf-page-icon {
  width: 44px;
  height: 44px;

  display: grid;
  place-items: center;

  color: #4f46e5;
  background: #eef2ff;

  border-radius: 11px;
}

.tf-page-title-row h1 {
  margin: 0;

  color: #101828;

  font-size: 25px;
  letter-spacing: -0.04em;
}

.tf-page-title-row p {
  margin: 5px 0 0;

  color: #667085;

  font-size: 10px;
}

.tf-application-summary {
  padding: 0 34px 20px;

  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
}

.tf-summary-card {
  padding: 15px 17px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: #fff;

  border: 1px solid var(--border);
  border-radius: 11px;

  box-shadow: var(--shadow-sm);
}

.tf-summary-card span {
  color: #667085;
  font-size: 10px;
  font-weight: 600;
}

.tf-summary-card strong {
  color: #101828;
  font-size: 20px;
  letter-spacing: -0.04em;
}

.tf-applications-card {
  margin: 0 34px;

  overflow: hidden;

  background: #fff;

  border: 1px solid var(--border);
  border-radius: 14px;

  box-shadow: var(--shadow-sm);
}

.tf-applications-toolbar {
  padding: 20px 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  border-bottom: 1px solid var(--border-light);
}

.tf-applications-toolbar h2 {
  margin: 0;

  color: #101828;

  font-size: 14px;
}

.tf-applications-toolbar span {
  display: block;

  margin-top: 4px;

  color: #98a2b3;

  font-size: 9px;
}

.tf-toolbar-controls {
  display: flex;
  align-items: center;
  gap: 9px;
}

.tf-search-box {
  width: 245px;
  height: 38px;

  padding: 0 11px;

  display: flex;
  align-items: center;
  gap: 8px;

  color: #98a2b3;
  background: #f8fafc;

  border: 1px solid #e4e7ec;
  border-radius: 8px;
}

.tf-search-box:focus-within {
  background: #fff;
  border-color: #a5b4fc;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.07);
}

.tf-search-box input {
  width: 100%;

  border: 0;
  outline: 0;

  color: #344054;
  background: transparent;

  font-size: 10px;
}

.tf-select-box {
  height: 38px;

  position: relative;

  display: flex;
  align-items: center;

  color: #667085;

  background: #fff;

  border: 1px solid #e4e7ec;
  border-radius: 8px;
}

.tf-select-box select {
  height: 100%;

  padding: 0 34px 0 11px;

  appearance: none;

  border: 0;
  outline: 0;

  color: #475467;
  background: transparent;

  font-size: 10px;
  cursor: pointer;
}

.tf-select-box svg {
  position: absolute;
  right: 9px;
  pointer-events: none;
}

.tf-table-wrapper {
  overflow-x: auto;
}

.tf-modern-table {
  width: 100%;

  border-collapse: collapse;
}

.tf-modern-table th {
  height: 43px;

  padding: 0 20px;

  color: #98a2b3;
  background: #fafbfc;

  border-bottom: 1px solid #eef0f4;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.07em;

  text-align: left;
  white-space: nowrap;
}

.tf-modern-table td {
  height: 70px;

  padding: 10px 20px;

  color: #475467;

  border-bottom: 1px solid #f2f4f7;

  font-size: 10px;
}

.tf-modern-table tbody tr {
  transition: background 0.16s ease;
}

.tf-modern-table tbody tr:hover {
  background: #fafbff;
}

.tf-job-title-cell {
  display: flex;
  align-items: center;
  gap: 10px;

  min-width: 200px;
}

.tf-job-title-cell > div:last-child {
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tf-job-title-cell strong {
  color: #344054;

  font-size: 10px;
  font-weight: 700;
}

.tf-job-title-cell span {
  color: #98a2b3;
  font-size: 9px;
}

.tf-company-name {
  color: #475467;
  font-size: 10px;
  font-weight: 600;
}

.tf-location,
.tf-date {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  color: #667085;

  font-size: 9px;
}

.tf-row-actions {
  display: flex;
  justify-content: flex-end;
  gap: 5px;
}

.tf-row-actions .tf-icon-button {
  width: 31px;
  height: 31px;

  color: #667085;

  background: #fff;

  border: 1px solid #e4e7ec;
}

.tf-row-actions .tf-icon-button:hover {
  color: #4f46e5;
  background: #f8faff;
  border-color: #c7d2fe;
}

.tf-row-actions .tf-icon-button.danger:hover {
  color: #d92d20;
  background: #fef3f2;
  border-color: #fecdca;
}

/* =========================================================
   MODAL
   ========================================================= */

.tf-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;

  display: grid;
  place-items: center;

  padding: 20px;

  background: rgba(16, 24, 40, 0.55);

  backdrop-filter: blur(5px);
}

.tf-modal {
  width: min(560px, 100%);

  overflow: hidden;

  background: #fff;

  border: 1px solid #eaecf0;
  border-radius: 15px;

  box-shadow:
    0 24px 60px rgba(16, 24, 40, 0.2);
}

.tf-modal-header {
  padding: 20px 22px;

  display: flex;
  justify-content: space-between;

  border-bottom: 1px solid #eef0f4;
}

.tf-modal-header h2 {
  margin: 0;

  color: #101828;

  font-size: 16px;
}

.tf-modal-close {
  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  color: #667085;
  background: #f8fafc;

  border-radius: 8px;

  cursor: pointer;
}

.tf-modal-close:hover {
  color: #344054;
  background: #f2f4f7;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1150px) {
  .tf-dashboard-grid {
    grid-template-columns: 1fr;
  }

  .tf-side-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .tf-kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .tf-application-summary {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 850px) {
  :root {
    --sidebar-width: 0px;
  }

  .tf-sidebar {
    display: none;
  }

  .tf-main {
    margin-left: 0;
  }

  .tf-mobile-brand {
    display: flex;
  }

  .tf-global-search {
    width: min(330px, 40vw);
  }

  .tf-dashboard,
  .tf-page-header {
    padding-left: 20px;
    padding-right: 20px;
  }

  .tf-application-summary {
    padding-left: 20px;
    padding-right: 20px;
  }

  .tf-applications-card {
    margin-left: 20px;
    margin-right: 20px;
  }
}

@media (max-width: 650px) {
  .tf-topbar {
    padding: 0 16px;
  }

  .tf-topbar-user-copy,
  .tf-topbar-divider {
    display: none;
  }

  .tf-global-search {
    display: none;
  }

  .tf-dashboard {
    padding: 22px 16px;
  }

  .tf-dashboard-header,
  .tf-page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .tf-dashboard-header h1 {
    font-size: 27px;
  }

  .tf-kpi-grid {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tf-kpi-card {
    min-height: 130px;
    padding: 15px;
  }

  .tf-kpi-label {
    font-size: 9px;
  }

  .tf-dashboard-grid {
    gap: 12px;
  }

  .tf-side-column {
    display: flex;
  }

  .tf-application-row {
    padding: 11px 15px;
  }

  .tf-row-date {
    display: none;
  }

  .tf-status {
    font-size: 8px;
  }

  .tf-page-header {
    padding: 22px 16px;
  }

  .tf-application-summary {
    padding: 0 16px 15px;
    grid-template-columns: repeat(2, 1fr);
  }

  .tf-applications-card {
    margin: 0 16px;
  }

  .tf-applications-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .tf-toolbar-controls {
    width: 100%;
    flex-direction: column;
  }

  .tf-search-box,
  .tf-select-box {
    width: 100%;
  }

  .tf-modern-table {
    min-width: 750px;
  }
}

@media (max-width: 420px) {
  .tf-kpi-grid {
    grid-template-columns: 1fr;
  }

  .tf-topbar {
    height: 64px;
  }

  .tf-brand-mark.small {
    width: 30px;
    height: 30px;
  }
}
@import 
url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");

:root {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #151827;
  background: #f7f8fc;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button,
input,
select,
textarea {
  font: inherit;
}

* {
  box-sizing: border-box;
}

::selection {
  background: #635bff;
  color: white;
}

::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: #f1f2f6;
}

::-webkit-scrollbar-thumb {
  background: #c8cbd5;
  border-radius: 99px;
}

#root {
  min-height: 100vh;
}

/* =========================================================
   TASKFLOW PROFESSIONAL DASHBOARD
   ========================================================= */

.tf-app-shell {
  min-height: 100vh;
  background: #f7f8fc;
}

.tf-main {
  min-height: 100vh;
  margin-left: 252px;
  padding: 0 34px 40px;
  color: #111827;
}

.tf-dashboard-header {
  max-width: 1440px;
  margin: 0 auto 26px;
  padding: 25px 0 5px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
}

.tf-eyebrow,
.tf-section-label {
  color: #7c3aed;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .13em;
}

.tf-eyebrow {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 9px;
}

.tf-live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 4px rgba(34,197,94,.1);
}

.tf-dashboard-header h1 {
  margin: 0;
  color: #111827;
  font-size: 31px;
  line-height: 1.15;
  letter-spacing: -.04em;
  font-weight: 800;
}

.tf-dashboard-header h1 span {
  color: #4f46e5;
}

.tf-dashboard-header p {
  margin: 8px 0 0;
  color: #64748b;
  font-size: 13px;
}

.tf-primary-button,
.tf-outline-button,
.tf-cancel-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 17px;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: .2s ease;
}

.tf-primary-button {
  color: #fff;
  background: #4f46e5;
  box-shadow: 0 7px 18px rgba(79,70,229,.18);
}

.tf-primary-button:hover {
  background: #4338ca;
  transform: translateY(-1px);
}

.tf-outline-button {
  color: #475569;
  border: 1px solid #e2e8f0;
  background: #fff;
}

.tf-outline-button:hover {
  color: #4f46e5;
  border-color: #c7d2fe;
  background: #f8faff;
}

.tf-kpi-grid {
  max-width: 1440px;
  margin: 0 auto 24px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
}

.tf-kpi-card {
  min-height: 158px;
  padding: 20px;
  position: relative;
  overflow: hidden;
  border: 1px solid #e8eaf1;
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 4px 18px rgba(15,23,42,.035);
}

.tf-kpi-card::after {
  content: "";
  position: absolute;
  right: -30px;
  bottom: -45px;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: rgba(99,102,241,.035);
}

.tf-kpi-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  margin-bottom: 15px;
}

.tf-kpi-icon.purple {
  color: #6366f1;
  background: #eef2ff;
}

.tf-kpi-icon.blue {
  color: #2563eb;
  background: #eff6ff;
}

.tf-kpi-icon.orange {
  color: #d97706;
  background: #fffbeb;
}

.tf-kpi-icon.green {
  color: #059669;
  background: #ecfdf5;
}

.tf-kpi-value {
  color: #111827;
  font-size: 26px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -.04em;
}

.tf-kpi-label {
  margin-top: 7px;
  color: #475569;
  font-size: 12px;
  font-weight: 700;
}

.tf-kpi-trend {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 13px;
  color: #94a3b8;
  font-size: 10px;
  font-weight: 600;
}

.tf-content-card {
  max-width: 1440px;
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid #e8eaf1;
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 4px 18px rgba(15,23,42,.035);
}

.tf-card-header {
  padding: 22px 23px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.tf-card-header h2 {
  margin: 0;
  color: #111827;
  font-size: 17px;
  letter-spacing: -.02em;
}

.tf-card-header p {
  margin: 5px 0 0;
  color: #94a3b8;
  font-size: 11px;
}

.tf-toolbar {
  padding: 0 23px 18px;
  display: flex;
  justify-content: space-between;
  gap: 14px;
  border-bottom: 1px solid #eef0f4;
}

.tf-search {
  width: 330px;
  height: 38px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  color: #94a3b8;
  background: #fafbfc;
}

.tf-search input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: #334155;
  font-size: 11px;
}

.tf-search input::placeholder {
  color: #a1aab8;
}

.tf-filter-group {
  display: flex;
  align-items: center;
  gap: 5px;
}

.tf-filter {
  height: 34px;
  padding: 0 10px;
  border-radius: 7px;
  background: transparent;
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

.tf-filter:hover {
  background: #f8fafc;
}

.tf-filter.active {
  color: #4f46e5;
  background: #eef2ff;
}

.tf-table-wrap {
  overflow-x: auto;
}

.tf-modern-table {
  width: 100%;
  border-collapse: collapse;
}

.tf-modern-table th {
  height: 42px;
  padding: 0 23px;
  color: #94a3b8;
  background: #fcfcfd;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .09em;
  text-align: left;
  white-space: nowrap;
}

.tf-modern-table td {
  height: 70px;
  padding: 10px 23px;
  border-top: 1px solid #f0f2f5;
  color: #475569;
  font-size: 11px;
}

.tf-modern-table tbody tr {
  transition: background .18s ease;
}

.tf-modern-table tbody tr:hover {
  background: #fafbff;
}

.tf-company-cell {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 180px;
}

.tf-company-logo {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #f1f5f9;
  color: #475569;
  font-size: 12px;
  font-weight: 800;
}

.tf-company-cell div:last-child {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.tf-company-cell strong,
.tf-position {
  color: #1e293b;
  font-size: 11px;
  font-weight: 750;
}

.tf-company-cell span,
.tf-location {
  color: #94a3b8;
  font-size: 10px;
}

.tf-status {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 800;
}

.status-applied {
  color: #2563eb;
  background: #eff6ff;
}

.status-interview {
  color: #b45309;
  background: #fffbeb;
}

.status-offer {
  color: #059669;
  background: #ecfdf5;
}

.status-rejected {
  color: #dc2626;
  background: #fef2f2;
}

.tf-row-actions {
  display: flex;
  justify-content: flex-end;
  gap: 5px;
}

.tf-icon-action {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border: 1px solid #e5e7eb;
  border-radius: 7px;
  background: #fff;
  color: #64748b;
  cursor: pointer;
  transition: .18s ease;
}

.tf-icon-action:hover {
  color: #4f46e5;
  border-color: #c7d2fe;
  background: #f8faff;
}

.tf-icon-action.danger:hover {
  color: #dc2626;
  border-color: #fecaca;
  background: #fef2f2;
}

.tf-table-footer {
  min-height: 52px;
  padding: 0 23px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #eef0f4;
  color: #94a3b8;
  font-size: 10px;
}

.tf-table-footer strong {
  color: #475569;
}

.tf-footer-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #4f46e5;
  font-weight: 700;
}

.tf-bottom-grid {
  max-width: 1440px;
  margin: 18px auto 0;
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 15px;
}

.tf-insight-card,
.tf-mini-card {
  min-height: 145px;
  padding: 20px;
  border: 1px solid #e8eaf1;
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 4px 18px rgba(15,23,42,.035);
}

.tf-insight-card {
  display: flex;
  align-items: center;
  gap: 15px;
}

.tf-insight-icon {
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #4f46e5;
  background: #eef2ff;
}

.tf-insight-card h3,
.tf-mini-card h3 {
  margin: 5px 0 5px;
  color: #1e293b;
  font-size: 14px;
  letter-spacing: -.02em;
}

.tf-insight-card p {
  max-width: 500px;
  margin: 0;
  color: #94a3b8;
  font-size: 10px;
  line-height: 1.6;
}

.tf-arrow-button {
  width: 34px;
  height: 34px;
  margin-left: auto;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  color: #64748b;
  background: #fff;
}

.tf-mini-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  color: #94a3b8;
}

.tf-pipeline {
  margin-top: 14px;
  display: grid;
  gap: 10px;
}

.tf-pipeline-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 5px;
  color: #64748b;
  font-size: 9px;
  font-weight: 700;
}

.tf-pipeline-top strong {
  color: #334155;
}

.tf-progress {
  height: 5px;
  overflow: hidden;
  border-radius: 999px;
  background: #f1f5f9;
}

.tf-progress-bar {
  height: 100%;
  border-radius: inherit;
}

.tf-progress-bar.blue {
  background: #3b82f6;
}

.tf-progress-bar.orange {
  background: #f59e0b;
}

.tf-progress-bar.green {
  background: #10b981;
}

.tf-loading-row {
  height: 45px;
  border-radius: 6px;
  background: linear-gradient(
    90deg,
    #f8fafc 25%,
    #eef2f7 50%,
    #f8fafc 75%
  );
  background-size: 200% 100%;
  animation: tf-shimmer 1.3s infinite;
}

@keyframes tf-shimmer {
  from {
    background-position: 200% 0;
  }

  to {
    background-position: -200% 0;
  }
}

.tf-empty-state {
  padding: 55px 20px;
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.tf-empty-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  margin-bottom: 12px;
  border-radius: 13px;
  color: #6366f1;
  background: #eef2ff;
}

.tf-empty-state h3 {
  margin: 0;
  color: #1e293b;
  font-size: 14px;
}

.tf-empty-state p {
  margin: 6px 0 17px;
  color: #94a3b8;
  font-size: 10px;
}

.tf-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(15,23,42,.5);
  backdrop-filter: blur(5px);
}

.tf-modal {
  width: min(560px, 100%);
  overflow: hidden;
  border: 1px solid #e2e8f0;
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 25px 80px rgba(15,23,42,.22);
}

.tf-modal-header {
  padding: 22px 23px;
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid #eef0f4;
}

.tf-modal-header h2 {
  margin: 5px 0 0;
  color: #111827;
  font-size: 18px;
  letter-spacing: -.03em;
}

.tf-modal-close {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  color: #94a3b8;
  background: #f8fafc;
  cursor: pointer;
}

.tf-form-grid {
  padding: 22px 23px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.tf-form-grid label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: #475569;
  font-size: 10px;
  font-weight: 750;
}

.tf-form-grid input,
.tf-form-grid select {
  width: 100%;
  height: 40px;
  padding: 0 11px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  outline: none;
  background: #fafbfc;
  color: #1e293b;
  font-size: 11px;
}

.tf-form-grid input:focus,
.tf-form-grid select:focus {
  border-color: #818cf8;
  box-shadow: 0 0 0 3px rgba(99,102,241,.08);
}

.tf-modal-actions {
  padding: 16px 23px;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  border-top: 1px solid #eef0f4;
  background: #fcfcfd;
}

.tf-cancel-button {
  color: #475569;
  border: 1px solid #e2e8f0;
  background: #fff;
}

@media (max-width: 1100px) {
  .tf-kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .tf-bottom-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 900px) {
  .tf-main {
    margin-left: 72px;
    padding: 0 20px 30px;
  }
}

@media (max-width: 700px) {
  .tf-dashboard-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .tf-kpi-grid {
    grid-template-columns: 1fr 1fr;
  }

  .tf-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .tf-search {
    width: 100%;
  }

  .tf-filter-group {
    overflow-x: auto;
  }

  .tf-card-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .tf-form-grid {
    grid-template-columns: 1fr;
  }

  .tf-table-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
    padding: 14px 23px;
  }
}

@media (max-width: 520px) {
  .tf-main {
    margin-left: 0;
    padding: 0 12px 25px;
  }

  .tf-kpi-grid {
    grid-template-columns: 1fr;
  }

  .tf-dashboard-header h1 {
    font-size: 26px;
  }

  .tf-primary-button {
    width: 100%;
  }

  .tf-insight-card {
    align-items: flex-start;
  }
}

/* =========================================================
   PROFESSIONAL APPLICATIONS PAGE
   ========================================================= */

.tf-app-shell {
  min-height: 100vh;
  background: #f8fafc;
}

.tf-main {
  min-height: 100vh;
  margin-left: 252px;
  padding: 28px 32px 50px;
}

.tf-page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin: 10px 0 28px;
}

.tf-back-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 15px;
  color: #64748b;
  font-size: 12px;
  font-weight: 600;
  transition: color .2s ease;
}

.tf-back-link:hover {
  color: #4f46e5;
}

.tf-page-title-row {
  display: flex;
  align-items: center;
  gap: 14px;
}

.tf-page-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: #4f46e5;
  background: #eef2ff;
}

.tf-page-title-row h1 {
  margin: 0;
  color: #0f172a;
  font-size: 28px;
  line-height: 1.15;
  letter-spacing: -.035em;
}

.tf-page-title-row p {
  margin: 6px 0 0;
  color: #64748b;
  font-size: 13px;
}

.tf-primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 16px;
  border-radius: 10px;
  background: #4f46e5;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  box-shadow: 0 8px 18px rgba(79,70,229,.18);
  transition: transform .2s ease, background .2s ease;
}

.tf-primary-button:hover {
  background: #4338ca;
  transform: translateY(-1px);
}

.tf-application-summary {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.tf-summary-card {
  padding: 17px 18px;
  background: #fff;
  border: 1px solid #e8edf4;
  border-radius: 13px;
  box-shadow: 0 3px 12px rgba(15,23,42,.035);
}

.tf-summary-card span {
  display: block;
  margin-bottom: 7px;
  color: #64748b;
  font-size: 11px;
  font-weight: 600;
}

.tf-summary-card strong {
  color: #0f172a;
  font-size: 24px;
  letter-spacing: -.03em;
}

.tf-applications-card {
  overflow: hidden;
  background: #fff;
  border: 1px solid #e8edf4;
  border-radius: 16px;
  box-shadow: 0 5px 22px rgba(15,23,42,.045);
}

.tf-applications-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 22px;
  border-bottom: 1px solid #edf1f5;
}

.tf-applications-toolbar h2 {
  margin: 0 0 4px;
  color: #0f172a;
  font-size: 15px;
  letter-spacing: -.015em;
}

.tf-applications-toolbar > div:first-child span {
  color: #94a3b8;
  font-size: 11px;
}

.tf-toolbar-controls {
  display: flex;
  gap: 10px;
}

.tf-search-box,
.tf-select-box {
  height: 38px;
  display: flex;
  align-items: center;
  border: 1px solid #e2e8f0;
  border-radius: 9px;
  background: #fff;
  color: #94a3b8;
}

.tf-search-box {
  width: 245px;
  gap: 8px;
  padding: 0 11px;
}

.tf-search-box input {
  width: 100%;
  border: 0;
  outline: 0;
  color: #334155;
  background: transparent;
  font-size: 12px;
}

.tf-search-box input::placeholder {
  color: #94a3b8;
}

.tf-select-box {
  position: relative;
  width: 145px;
  padding: 0 10px;
}

.tf-select-box select {
  width: 100%;
  appearance: none;
  border: 0;
  outline: 0;
  background: transparent;
  color: #475569;
  font-size: 12px;
  cursor: pointer;
}

.tf-select-box svg {
  pointer-events: none;
}

.tf-table-wrapper {
  overflow-x: auto;
}

.tf-modern-table {
  width: 100%;
  min-width: 850px;
  border-collapse: collapse;
}

.tf-modern-table th {
  padding: 12px 20px;
  background: #fafbfc;
  color: #94a3b8;
  border-bottom: 1px solid #edf1f5;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .06em;
  text-align: left;
  text-transform: uppercase;
}

.tf-modern-table td {
  padding: 16px 20px;
  border-bottom: 1px solid #f0f3f7;
  color: #475569;
  font-size: 12px;
  vertical-align: middle;
}

.tf-modern-table tbody tr {
  transition: background .18s ease;
}

.tf-modern-table tbody tr:hover {
  background: #fafbff;
}

.tf-modern-table tbody tr:last-child td {
  border-bottom: 0;
}

.tf-job-title-cell {
  display: flex;
  align-items: center;
  gap: 11px;
}

.tf-company-logo {
  width: 36px;
  height: 36px;
  display: grid;
  flex: 0 0 36px;
  place-items: center;
  border: 1px solid #e0e7ff;
  border-radius: 10px;
  background: #f1f3ff;
  color: #4f46e5;
  font-size: 12px;
  font-weight: 800;
}

.tf-job-title-cell strong {
  display: block;
  margin-bottom: 3px;
  color: #1e293b;
  font-size: 12px;
  font-weight: 700;
}

.tf-job-title-cell span {
  color: #94a3b8;
  font-size: 10px;
}

.tf-company-name {
  color: #334155;
  font-weight: 600;
}

.tf-location,
.tf-date {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #64748b;
}

.tf-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
}

.tf-status-badge > span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
}

.tf-status-badge.applied {
  background: #eff6ff;
  color: #2563eb;
}

.tf-status-badge.applied > span {
  background: #3b82f6;
}

.tf-status-badge.interview {
  background: #fffbeb;
  color: #d97706;
}

.tf-status-badge.interview > span {
  background: #f59e0b;
}

.tf-status-badge.offer {
  background: #ecfdf5;
  color: #059669;
}

.tf-status-badge.offer > span {
  background: #10b981;
}

.tf-status-badge.rejected {
  background: #fef2f2;
  color: #dc2626;
}

.tf-status-badge.rejected > span {
  background: #ef4444;
}

.tf-row-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.tf-icon-button {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #fff;
  color: #64748b;
  cursor: pointer;
  transition: .18s ease;
}

.tf-icon-button:hover {
  border-color: #c7d2fe;
  background: #eef2ff;
  color: #4f46e5;
}

.tf-icon-button.danger:hover {
  border-color: #fecaca;
  background: #fef2f2;
  color: #dc2626;
}

.tf-empty-state {
  min-height: 330px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 40px;
  text-align: center;
}

.tf-empty-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  margin-bottom: 4px;
  border-radius: 15px;
  background: #eef2ff;
  color: #4f46e5;
}

.tf-empty-state h3 {
  margin: 0;
  color: #1e293b;
  font-size: 14px;
}

.tf-empty-state p {
  max-width: 380px;
  margin: 0 0 8px;
  color: #94a3b8;
  font-size: 12px;
  line-height: 1.6;
}

.tf-spinner {
  width: 30px;
  height: 30px;
  margin-bottom: 8px;
  border: 3px solid #e2e8f0;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: tf-spin .8s linear infinite;
}

@keyframes tf-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 1100px) {
  .tf-application-summary {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 900px) {
  .tf-main {
    margin-left: 72px;
    padding: 24px 20px 40px;
  }
}

@media (max-width: 700px) {
  .tf-page-header,
  .tf-applications-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .tf-toolbar-controls {
    width: 100%;
  }

  .tf-search-box {
    flex: 1;
    width: auto;
  }

  .tf-application-summary {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* =========================================================
   TASKFLOW PROFESSIONAL DASHBOARD
   ========================================================= */

.tf-app-shell {
  min-height: 100vh;
  background: #f7f8fc;
}

.tf-main {
  min-height: 100vh;
  margin-left: 252px;
  padding: 0 32px 40px;
}

.tf-dashboard {
  max-width: 1480px;
  margin: 0 auto;
}

.tf-dashboard-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  padding: 32px 0 28px;
}

.tf-eyebrow {
  display: block;
  margin-bottom: 9px;
  color: #7c3aed;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .13em;
}

.tf-dashboard-header h1 {
  margin: 0;
  color: #151923;
  font-size: 32px;
  line-height: 1.15;
  letter-spacing: -.035em;
}

.tf-dashboard-header h1 span {
  color: #5b5bd6;
}

.tf-dashboard-header p {
  margin: 9px 0 0;
  color: #7a8090;
  font-size: 14px;
}

.tf-primary-button,
.tf-secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  transition: .2s ease;
}

.tf-primary-button {
  min-height: 44px;
  padding: 0 17px;
  background: #5b5bd6;
  color: #fff;
  box-shadow: 0 8px 22px rgba(91, 91, 214, .18);
}

.tf-primary-button:hover {
  transform: translateY(-1px);
  background: #4f46c8;
}

.tf-secondary-button {
  min-height: 40px;
  padding: 0 14px;
  background: #f1f2ff;
  color: #5757ca;
}

.tf-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.tf-kpi-card {
  min-height: 158px;
  padding: 20px;
  border: 1px solid #e9eaf0;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 3px 14px rgba(26, 32, 44, .035);
}

.tf-kpi-top {
  display: flex;
  align-items: center;
  gap: 10px;
}

.tf-kpi-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 9px;
}

.tf-kpi-card.blue .tf-kpi-icon {
  background: #edf4ff;
  color: #3975e8;
}

.tf-kpi-card.violet .tf-kpi-icon {
  background: #f1efff;
  color: #7562d8;
}

.tf-kpi-card.amber .tf-kpi-icon {
  background: #fff7e8;
  color: #d99424;
}

.tf-kpi-card.green .tf-kpi-icon {
  background: #eaf9f2;
  color: #2a9a68;
}

.tf-kpi-label {
  color: #737988;
  font-size: 12px;
  font-weight: 600;
}

.tf-kpi-card > strong {
  display: block;
  margin-top: 20px;
  color: #171b25;
  font-size: 29px;
  line-height: 1;
  letter-spacing: -.04em;
}

.tf-kpi-detail {
  display: block;
  margin-top: 9px;
  color: #9a9eaa;
  font-size: 11px;
}

.tf-dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(300px, .8fr);
  gap: 18px;
  margin-top: 18px;
}

.tf-panel {
  border: 1px solid #e9eaf0;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 3px 14px rgba(26, 32, 44, .035);
}

.tf-panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  padding: 21px 22px 17px;
}

.tf-panel-header h2 {
  margin: 0;
  color: #1a1e28;
  font-size: 15px;
  letter-spacing: -.015em;
}

.tf-panel-header p {
  margin: 5px 0 0;
  color: #969ba8;
  font-size: 11px;
}

.tf-text-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #5b5bd6;
  font-size: 11px;
  font-weight: 700;
}

.tf-search-wrapper {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0 22px 10px;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #e8e9ee;
  border-radius: 9px;
  color: #a2a6b0;
  background: #fafbfc;
}

.tf-search-wrapper input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: #20242d;
  font-size: 12px;
}

.tf-search-wrapper input::placeholder {
  color: #a6aab4;
}

.tf-application-list {
  padding-bottom: 7px;
}

.tf-application-row {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr) auto 70px;
  align-items: center;
  gap: 12px;
  min-height: 68px;
  padding: 8px 22px;
  border-top: 1px solid #f0f1f4;
}

.tf-company-avatar {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #f0f0ff;
  color: #5b5bd6;
  font-size: 12px;
  font-weight: 800;
}

.tf-application-main {
  min-width: 0;
}

.tf-application-main strong {
  display: block;
  overflow: hidden;
  color: #252934;
  font-size: 12px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-application-main span {
  display: block;
  overflow: hidden;
  margin-top: 4px;
  color: #979ca8;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-status {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 9px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  white-space: nowrap;
}

.status-applied {
  background: #edf4ff;
  color: #3975e8;
}

.status-interview {
  background: #fff6e6;
  color: #c98416;
}

.status-offer {
  background: #eaf9f2;
  color: #278c60;
}

.status-rejected {
  background: #fff0f0;
  color: #dc5a5a;
}

.tf-row-date {
  color: #a1a5ae;
  font-size: 10px;
  text-align: right;
}

.tf-side-column {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.tf-progress-panel {
  min-height: 330px;
}

.tf-pipeline {
  padding: 2px 22px 22px;
}

.tf-pipeline-row {
  margin-top: 22px;
}

.tf-pipeline-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.tf-pipeline-label span {
  color: #717684;
  font-size: 11px;
  font-weight: 600;
}

.tf-pipeline-label strong {
  color: #272b35;
  font-size: 11px;
}

.tf-progress-track {
  height: 7px;
  overflow: hidden;
  border-radius: 99px;
  background: #f0f1f5;
}

.tf-progress-fill {
  height: 100%;
  min-width: 0;
  border-radius: inherit;
}

.tf-progress-fill.blue {
  background: #4c85ec;
}

.tf-progress-fill.amber {
  background: #e8a32c;
}

.tf-progress-fill.green {
  background: #38a873;
}

.tf-progress-fill.red {
  background: #df6464;
}

.tf-insight-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 18px;
  border: 1px solid #e7e6fb;
  border-radius: 14px;
  background: linear-gradient(135deg, #f8f7ff, #fdfdff);
}

.tf-insight-icon {
  width: 35px;
  height: 35px;
  flex: 0 0 35px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #e9e7ff;
  color: #665ed0;
}

.tf-insight-card strong {
  display: block;
  color: #3b3d48;
  font-size: 12px;
}

.tf-insight-card p {
  margin: 5px 0 0;
  color: #858996;
  font-size: 10px;
  line-height: 1.55;
}

.tf-empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 48px 25px;
  text-align: center;
}

.tf-empty-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: #f1f1ff;
  color: #6661d5;
}

.tf-empty-state h3 {
  margin: 14px 0 5px;
  color: #30333d;
  font-size: 14px;
}

.tf-empty-state p {
  max-width: 300px;
  margin: 0 0 18px;
  color: #979ba7;
  font-size: 11px;
  line-height: 1.6;
}

.tf-loading-list {
  padding: 10px 22px 20px;
}

.tf-skeleton-row {
  display: grid;
  grid-template-columns: 38px 1fr 80px;
  gap: 12px;
  align-items: center;
  min-height: 68px;
  border-top: 1px solid #f0f1f4;
}

.tf-skeleton-row div {
  height: 12px;
  border-radius: 6px;
  background: linear-gradient(
    90deg,
    #f0f1f4 25%,
    #f7f8fa 50%,
    #f0f1f4 75%
  );
  background-size: 200% 100%;
  animation: tf-shimmer 1.4s infinite;
}

.tf-skeleton-row div:first-child {
  width: 34px;
  height: 34px;
  border-radius: 9px;
}

@keyframes tf-shimmer {
  from {
    background-position: 200% 0;
  }

  to {
    background-position: -200% 0;
  }
}

@media (max-width: 1050px) {
  .tf-kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .tf-dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 900px) {
  .tf-main {
    margin-left: 72px;
    padding: 0 20px 30px;
  }
}

@media (max-width: 700px) {
  .tf-dashboard-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .tf-primary-button {
    width: 100%;
  }

  .tf-application-row {
    grid-template-columns: 38px minmax(0, 1fr) auto;
  }

  .tf-row-date {
    display: none;
  }
}

@media (max-width: 500px) {
  .tf-main {
    padding: 0 12px 25px;
  }

  .tf-kpi-grid {
    grid-template-columns: 1fr;
  }

  .tf-dashboard-header h1 {
    font-size: 26px;
  }

  .tf-application-row {
    grid-template-columns: 34px minmax(0, 1fr);
  }

  .tf-status {
    grid-column: 2;
    justify-self: start;
  }
}
